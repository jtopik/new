local function copyToClipboard(text)
    local clipboard = setclipboard or toclipboard or (syn and syn.clipboard) or (secure_load and secure_load("clipboard")) or function(t)
        game:GetService("GuiService"):SetClipboard(t)
    end
    clipboard(text)
end

